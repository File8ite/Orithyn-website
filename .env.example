# Web3Forms Public Access Key for Contact Form Delivery
#
# How to configure:
# 1. Visit https://web3forms.com
# 2. Enter destination email: contact@orithyn.com
# 3. Retrieve the generated Access Key from your inbox
# 4. Create a .env.local file in this repository root and paste the key below:
#
# Note: Web3Forms access keys are designed specifically for public frontend use.
# They are not private secrets and can only deliver to the verified registered email.

NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
